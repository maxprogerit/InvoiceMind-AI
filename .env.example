# Copy to .env and fill in. `docker compose up --build` reads this file.
# Values marked DEV ONLY are fine for a local demo and MUST be changed in production.

# --- OpenAI (required for extraction) ---------------------------------------
# Get a key at https://platform.openai.com/api-keys  (never commit it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high ... (extraction does not need deep reasoning)
OPENAI_REASONING_EFFORT=none
# USD per 1M tokens, used only to store an estimated cost per invoice
OPENAI_PRICE_INPUT_PER_1M=0.10
OPENAI_PRICE_OUTPUT_PER_1M=0.50

# --- Internal service auth ---------------------------------------------------
# Shared secret between backend and ai-service (DEV ONLY value)
AI_SERVICE_TOKEN=dev-only-internal-token-change-me
# HMAC key for JWTs, at least 32 characters (DEV ONLY value)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# --- Database ----------------------------------------------------------------
POSTGRES_DB=invoicemind
POSTGRES_USER=invoicemind
POSTGRES_PASSWORD=dev-only-change-me

# --- Demo data ---------------------------------------------------------------
# On first start the backend creates this organisation with 3 users
# (admin / approver / user @ demo.invoicemind.local) sharing this password.
# Leave DEMO_PASSWORD empty to disable seeding.
DEMO_PASSWORD=Demo12345!

# --- Ports -------------------------------------------------------------------
# Only Nginx is exposed to the network; the rest bind to 127.0.0.1 for debugging.
HTTP_PORT=80
POSTGRES_HOST_PORT=15432

# --- Developer overlay (docker-compose.dev.yml) ---------------------------------
DEV_BACKEND_PORT=18080
DEV_AI_PORT=18000
