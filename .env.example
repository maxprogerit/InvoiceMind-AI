# Copy to .env and fill in. `docker compose up --build` reads this file.
# Values marked DEV ONLY are fine for a local demo and MUST be changed in production.

# --- OpenAI (required for extraction) ---------------------------------------
# Get a key at https://platform.openai.com/api-keys  (never commit it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# none | low | medium | high ... (extraction does not need deep reasoning)
OPENAI_REASONING_EFFORT=none
# USD per 1M tokens, used only to store an estimated cost per invoice
OPENAI_PRICE_INPUT_PER_1M=0.10
OPENAI_PRICE_OUTPUT_PER_1M=0.50
# Embeddings power the knowledge base (rules documents -> "why was this flagged?")
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens, 0 = do not track (check the OpenAI pricing page)
OPENAI_EMBEDDING_PRICE_PER_1M=0

# --- Internal service auth ---------------------------------------------------
# Shared secret between backend and ai-service (DEV ONLY value)
AI_SERVICE_TOKEN=dev-only-internal-token-change-me
# HMAC key for JWTs, at least 32 characters (DEV ONLY value)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# --- Database ----------------------------------------------------------------
POSTGRES_DB=invoicemind
POSTGRES_USER=invoicemind
POSTGRES_PASSWORD=dev-only-change-me

# --- Currency conversion ---------------------------------------------------
# Analytics can report in one currency. ECB reference rates are downloaded from
# https://api.frankfurter.dev (only dates leave your server, no invoice data).
# Set to false to run fully offline and enter rates by hand under Settings.
FX_RATES_ENABLED=true

# --- Single sign-on (OpenID Connect) -------------------------------------------
# Any OIDC provider (Entra ID, Okta, Keycloak, Google Workspace ...). Register this redirect URI at the provider:
#   <public URL of the app>/api/v1/auth/oidc/callback
# People must already have an account (matched by verified e-mail), or set OIDC_PROVISION_ORG_ID (an organisation id,
# shown under Settings) plus OIDC_ALLOWED_EMAIL_DOMAINS to create accounts on first sign-in with OIDC_DEFAULT_ROLE.
OIDC_ENABLED=false
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=Single sign-on
OIDC_PUBLIC_URL=
OIDC_PROVISION_ORG_ID=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_DEFAULT_ROLE=USER

# --- E-mail ingestion ----------------------------------------------------------
# Poll an IMAP mailbox; mail sent to  <mailbox>+<token>@<domain>  (the exact address, with the organisation's
# token, is shown under Settings) is imported, provided the sender is a user of that organisation.
# Works with any IMAP mailbox that supports plus-addressing (Gmail, Outlook, Fastmail ...; use an app password).
MAIL_INGEST_ENABLED=false
MAIL_INGEST_ADDRESS=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
# true = require dkim=pass or spf=pass in the Authentication-Results header added by your mail server
MAIL_REQUIRE_AUTH_RESULTS=false

# --- Tracing (OpenTelemetry) -----------------------------------------------
# TRACING_ENABLED=true makes backend and ai-service export spans over OTLP to any OTLP/HTTP collector
# (Jaeger, Tempo, an OpenTelemetry Collector ...); set OTEL_EXPORTER_OTLP_ENDPOINT below to its address.
TRACING_ENABLED=false

# --- File storage ------------------------------------------------------------
# local = a Docker volume (default). s3 = any S3-compatible store.
# AWS S3: STORAGE_TYPE=s3, S3_ENDPOINT= (empty), S3_PATH_STYLE=false, S3_CREATE_BUCKET=false, your bucket/region
# and real keys (or leave the keys empty to use an IAM role). MinIO, SeaweedFS ...: set S3_ENDPOINT and S3_PATH_STYLE=true.
STORAGE_TYPE=local
S3_ACCESS_KEY=invoicemind
S3_SECRET_KEY=dev-only-s3-secret-change-me

# --- Webhooks (ERP integration) ----------------------------------------------
# Webhook URLs are requested by the server, so private/internal addresses are refused by
# default (SSRF protection). Set true only for a receiver inside your own network.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# --- Demo data ---------------------------------------------------------------
# On first start the backend creates this organisation with 3 users
# (admin / approver / user @ demo.invoicemind.local) sharing this password.
# Leave DEMO_PASSWORD empty to disable seeding.
DEMO_PASSWORD=Demo12345!

# --- Ports -------------------------------------------------------------------
# Only Nginx is exposed to the network; the rest bind to 127.0.0.1 for debugging.
HTTP_PORT=80
POSTGRES_HOST_PORT=15432

# --- Browser-test overlay (docker-compose.e2e.yml) ------------------------------
DEV_BACKEND_PORT=18080   # host port the overlay publishes the backend on

# --- OCR engine ----------------------------------------------------------------
# tesseract (default) or paddle. Paddle needs the image built with PaddleOCR (~1 GB more):
#   WITH_PADDLE=1 docker compose build ai-service      then   OCR_ENGINE=paddle
# PADDLE_LANG: a PaddleOCR language code: de (German, also reads English), en, ru (Russian) ...; one model per language.
OCR_ENGINE=tesseract
WITH_PADDLE=0
PADDLE_LANG=de

# --- Advanced (defaults shown; uncomment to change) ----------------------------------
# MAIL_IMAP_FOLDER=INBOX
# MAIL_POLL_SECONDS=60
# OIDC_SCOPES=openid email profile
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# S3_BUCKET=invoicemind
# S3_REGION=us-east-1
# S3_ENDPOINT=                         # empty for AWS S3
# S3_PATH_STYLE=true                  # false for AWS S3
# S3_CREATE_BUCKET=true               # false for AWS S3
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
