# Copy to .env and fill in. `docker compose up --build` reads this file.
# Values marked DEV ONLY are fine for a local demo and MUST be changed in production.

# --- OpenAI (required for extraction) ---------------------------------------
# Get a key at https://platform.openai.com/api-keys  (never commit it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high ... (extraction does not need deep reasoning)
OPENAI_REASONING_EFFORT=none
# USD per 1M tokens, used only to store an estimated cost per invoice
OPENAI_PRICE_INPUT_PER_1M=0.10
OPENAI_PRICE_OUTPUT_PER_1M=0.50
# Embeddings power the knowledge base (rules documents -> "why was this flagged?")
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens, 0 = do not track (check the OpenAI pricing page)
OPENAI_EMBEDDING_PRICE_PER_1M=0

# --- Internal service auth ---------------------------------------------------
# Shared secret between backend and ai-service (DEV ONLY value)
AI_SERVICE_TOKEN=dev-only-internal-token-change-me
# HMAC key for JWTs, at least 32 characters (DEV ONLY value)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# --- Database ----------------------------------------------------------------
POSTGRES_DB=invoicemind
POSTGRES_USER=invoicemind
POSTGRES_PASSWORD=dev-only-change-me

# --- Currency conversion ---------------------------------------------------
# Analytics can report in one currency. ECB reference rates are downloaded from
# https://api.frankfurter.dev (only dates leave your server, no invoice data).
# Set to false to run fully offline and enter rates by hand under Settings.
FX_RATES_ENABLED=true

# --- Tracing (OpenTelemetry) -----------------------------------------------
# TRACING_ENABLED=true makes backend and ai-service export spans over OTLP. The bundled viewer:
#   docker compose --profile tracing up --build      then open http://localhost:16686
TRACING_ENABLED=false
JAEGER_UI_PORT=16686

# --- File storage ------------------------------------------------------------
# local = a Docker volume (default). s3 = any S3-compatible store: start the bundled one with
#   docker compose --profile s3 up --build        (keys below are DEV ONLY values)
# For AWS S3 itself: STORAGE_TYPE=s3, S3_ENDPOINT= (empty), S3_PATH_STYLE=false, S3_CREATE_BUCKET=false,
# your bucket/region and real keys (or leave the keys empty to use an IAM role).
STORAGE_TYPE=local
S3_ACCESS_KEY=invoicemind
S3_SECRET_KEY=dev-only-s3-secret-change-me

# --- Webhooks (ERP integration) ----------------------------------------------
# Webhook URLs are requested by the server, so private/internal addresses are refused by
# default (SSRF protection). Set true only for a receiver inside your own network.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# --- Demo data ---------------------------------------------------------------
# On first start the backend creates this organisation with 3 users
# (admin / approver / user @ demo.invoicemind.local) sharing this password.
# Leave DEMO_PASSWORD empty to disable seeding.
DEMO_PASSWORD=Demo12345!

# --- Ports -------------------------------------------------------------------
# Only Nginx is exposed to the network; the rest bind to 127.0.0.1 for debugging.
HTTP_PORT=80
POSTGRES_HOST_PORT=15432

# --- Developer overlay (docker-compose.dev.yml) ---------------------------------
DEV_BACKEND_PORT=18080
DEV_AI_PORT=18000
